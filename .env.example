# Configure one provider for domain_assistant.py answer generation.
# Copy this file to .env and set the key for the provider you use.
# If both provider keys are set, GEMINI_API_KEY takes precedence.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
